	<munit:config name="order-api-insufficient-stock-test.xml" />
	<munit:test name="order-api-insufficient-stock-test-post:\orders:application\json:RouterTest" doc:id="019fe6a8-6320-4375-80f6-5d574df586cb" description="Test" expectedErrorType="APP:INSUFFICIENT_STOCK">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock when" doc:id="133167d3-ae55-46b2-8190-f2c7cbc28507" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="GET" attributeName="method" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;  productId: "P001",&#10;  productName: "Laptop",&#10;  price: 5000,&#10;  availableStock: 10&#10;}]' mediaType="application/json" />
				</munit-tools:then-return>
