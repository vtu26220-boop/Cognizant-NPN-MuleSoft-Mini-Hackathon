		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="b7684770-8d40-446a-9528-ab63a9600987" >
				<munit:payload value='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;  customerId: "CUST001",&#10;  customerName: "Pradeep",&#10;  customerEmail: "pradeep@gmail.com",&#10;  items: [&#10;    {&#10;      productId: "P001",&#10;      quantity: 11&#10;    }&#10;  ]&#10;}]' mediaType="application/json" />
