			<flow-ref doc:name="Flow-ref to post:\orders:application\json:Router" doc:id="4c21d8ac-d346-4f3f-9421-7aa7a1cfba9c" name="post:\orders:application\json:Router"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-equals doc:name="Assert equals" doc:id="8556f85e-04b1-460c-9237-6678f3ef430d" actual="#[payload.errorCode]" expected='#["INSUFFICIENT_STOCK"]'/>
		</munit:validation>
	</munit:test>


</mule>
