<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
	<munit:config name="order-api-internal-server-error-test.xml" />
	<munit:test name="order-api-internal-server-error-test-order-apiFlowTest" doc:id="69b62a69-e62b-4603-abce-9d102590b213" description="Test">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock when" doc:id="dca6729f-db96-46bf-8bf8-77fd123bb3e1" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="POST" attributeName="method" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:error typeId="MULE:EXPRESSION" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock when" doc:id="dd96603c-a02d-4981-bbd9-a08d9aaa81b6" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="GET" attributeName="method" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;  productId: "P001",&#10;  productName: "Laptop",&#10;  price: 5000,&#10;  availableStock: 10&#10;}]' mediaType="application/json" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock when" doc:id="f76ff0e8-2533-44f2-bdde-c5a3cffed20e" processor="apikit:router">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="APIkit Router" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;  orderId: "ORD1001",&#10;  customerId: "CUST001",&#10;  subtotal: 10000,&#10;  discount: 0,&#10;  totalAmount: 10000,&#10;  status: "CONFIRMED",&#10;  message: "Order created successfully"&#10;}]' mediaType="application/json" />
					<munit-tools:error typeId="MULE:EXPRESSION" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="0c125987-d379-4f7f-ba15-82b25ead72e5" >
				<munit:payload value='#[{&#10;  "customerId": "CUST001",&#10;  "customerName": "Pradeep",&#10;  "customerEmail": "pradeep@gmail.com",&#10;  "items": [&#10;    {&#10;      "productId": "P001",&#10;      "quantity": 2&#10;    }&#10;  ]&#10;}]' encoding="UTF-8" mediaType="application/json" />
			</munit:set-event>
			<flow-ref doc:name="Flow-ref to order-apiFlow" doc:id="968f1259-9d68-4b4e-9b65-8b01f7c7afb3" name="order-apiFlow"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-equals doc:name="Assert equals" doc:id="d1f2bc0e-8891-4a14-a10a-e5d547118a68" actual="#[payload.errorCode]" expected='#["INTERNAL_SERVER_ERROR"]'/>
		</munit:validation>
	</munit:test>


</mule>
