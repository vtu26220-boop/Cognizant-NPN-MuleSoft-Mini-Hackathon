		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Event" doc:id="4e17d912-f398-4ca3-9593-d0f1c297de2a" >
				<munit:payload value='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;  customerId: "CUST001",&#10;  customerName: "Pradeep",&#10;  customerEmail: "pradeep@gmail.com",&#10;  items: [&#10;    {&#10;      productId: "P001",&#10;      quantity: 2&#10;    }&#10;  ]&#10;}]' mediaType="application/json" />
			</munit:set-event>
			<flow-ref doc:name="Flow-ref to post:\orders:application\json:Router" doc:id="d8b7e96d-2548-4504-907b-84e18573460d" name="post:\orders:application\json:Router"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-equals doc:name="Assert equals" doc:id="a5b06da1-63a6-49b5-a964-b78d360b4b89" actual='#["ORD1001"]' expected='#["ORD1001"]'/>
		</munit:validation>
	</munit:test>


</mule>
